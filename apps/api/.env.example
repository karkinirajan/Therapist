ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://therapist:therapist@localhost:5433/therapist
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Optional — overrides the refresh_token/oauth-state cookies' `Secure` flag
# (default: true when ENVIRONMENT=production). Set to false only for a
# production deploy still on plain HTTP with no domain/TLS yet.
COOKIE_SECURE=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

FRONTEND_URL=http://localhost:3000

CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Optional — voice therapy feature. Leave blank to disable it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
VOICE_DAILY_SESSION_LIMIT=5
VOICE_DAILY_TURN_LIMIT=60
