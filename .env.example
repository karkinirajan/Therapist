# Root-level env for Docker Compose. Copy to `.env` before running any
# `docker compose` command from the repo root:
#   cp .env.example .env
#
# Used by:
#   - docker-compose.yml alone: local Postgres only, if you're running
#     the API/web apps yourself with `uv run`/`npm run dev` (see README's
#     "Running locally" — the granular, non-Docker path).
#   - docker-compose.yml (+ docker-compose.override.yml, auto-loaded):
#     `docker compose up` — full stack (db + api + web), dev mode, hot
#     reload, sensible dev defaults below are safe to use as-is.
#   - docker-compose.yml + docker-compose.prod.yml: `docker compose -f
#     docker-compose.yml -f docker-compose.prod.yml up -d --build` — full
#     stack, production mode. The vars marked "REQUIRED for prod" below
#     MUST be set to real values first — prod mode fails fast at
#     `docker compose up` time (not silently) if they're left as
#     dev-only defaults, via Compose's `${VAR:?message}` syntax.
#
# apps/api itself also has its own apps/api/.env.example for anyone
# running the API directly with `uv run` (the non-Docker path) — the
# values below are the Docker Compose equivalents of the same settings.

# --- Postgres ---------------------------------------------------------
# Also used directly by `docker compose up -d postgres` for the
# granular/manual dev path. Change the password before running this
# anywhere beyond your own laptop.
POSTGRES_USER=therapist
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=therapist
# Host-mapped port (not 5432, to avoid colliding with a possible system
# Postgres). Only relevant if you connect to Postgres from outside
# Compose (e.g. a local `psql` or GUI client) — containers talk to each
# other over the internal `postgres:5432` address regardless of this.
POSTGRES_PORT=5433

# --- API (apps/api), read by the `api` Compose service -----------------
ENVIRONMENT=development
# REQUIRED for prod — a long random value, not this placeholder:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Optional — only needed if Google sign-in should work. Leave blank to
# disable it; the rest of the app works fine without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# REQUIRED for prod — your real deployed frontend origin(s). Dev default
# matches the Compose web service's published port.
FRONTEND_URL=http://localhost:3000
# REQUIRED for prod — JSON array of allowed origins, must match
# FRONTEND_URL exactly (scheme + host + port).
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- Web (apps/web), read by the `web` Compose service ------------------
# Server-only (never NEXT_PUBLIC_*) — the browser never calls the API
# origin directly, only this Next.js app's own same-origin proxy routes
# do (see apps/web/lib/auth-proxy.ts). Inside Compose this must be the
# `api` service's Compose DNS name, not `localhost` — containers don't
# share a network namespace with the host or each other by default, but
# Compose's built-in DNS resolves service names on the shared Compose
# network.
API_BASE_URL=http://api:8000
# Host-mapped port for the web container (dev and prod both publish it).
WEB_PORT=3000
